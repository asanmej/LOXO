{
    "description": "The expressions of the different rules follow the syntax of the SQL OLAP database \n        management system called DuckDB. For more information, visit https://duckdb.org/docs/sql/introduction. \n        Keep in mind that you only have to declare as a rule the statement that would follow a WHERE clause. \n        e.g.,  Select * from people WHERE {expression}\n        expression = age >= 18\n        ",
    "rules": [
        {
            "expression": "Id_pac IN (SELECT Id_pac FROM Pacientes)",
            "name": "integridad_referencial_paciente",
            "description": "Verifica que el Id_pac de la tabla Enfermedades exista en la tabla Pacientes."
        },
        {
            "expression": "F_factoresRiesgo BETWEEN 2012 AND 2022",
            "name": "F_factoresRiesgo",
            "description": "Rule for column F_factoresRiesgo"
        },
        {
            "expression": "Fumador IN ('Fumador', 'No_fumador', 'EX_Fumador', 'NA')",
            "name": "Fumador",
            "description": "Rule for column Fumador"
        },
        {
            "expression": "Alcohol IN ('No_Bebedor', 'Bebedor_BajoRiesgo', 'Bebedor_AltoRiesgo', 'NA')",
            "name": "Alcohol",
            "description": "Rule for column Alcohol"
        },
        {
            "expression": "Fragilidad_bi IN ('Si', 'No', 'NA')",
            "name": "Fragilidad_bi",
            "description": "Rule for column Fragilidad_bi"
        },
        {
            "expression": "Fragilidad_score BETWEEN 0 AND 36",
            "name": "Fragilidad_score",
            "description": "Rule for column Fragilidad_score"
        },
        {
            "expression": "Fragilidad_disease BETWEEN 0 AND 20",
            "name": "Fragilidad_disease",
            "description": "Rule for column Fragilidad_disease"
        },
        {
            "expression": "Fragilidad_SSLD BETWEEN 0 AND 16",
            "name": "Fragilidad_SSLD",
            "description": "Rule for column Fragilidad_SSLD"
        },
        {
            "expression": "Barthel_score BETWEEN 0 AND 100",
            "name": "Barthel_score",
            "description": "Rule for column Barthel_score"
        },
        {
            "expression": "Pfeiffer_score BETWEEN 1 AND 10",
            "name": "Pfeiffer_score",
            "description": "Rule for column Pfeiffer_score"
        },
        {
            "expression": "N_farmacos BETWEEN 0 AND 50",
            "name": "N_farmacos",
            "description": "Rule for column N_farmacos"
        }
    ]
}